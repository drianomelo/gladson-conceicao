---
import { Image } from "astro:assets";

import gladsonAbout from "../assets/images/about-gladson.png";
---

<section class="about-gladson" id="sobre" aria-labelledby="about-title">
  <Image
    src={gladsonAbout}
    alt="Gladson Conceição, advogado"
    width={900}
    quality={90}
    format="webp"
    loading="lazy"
  />
  <span class="about-name">GLADSON</span>
  <div class="about-overlay"></div>

  <div class="container about-container">
    <span class="about-dot about-dot-right-up"></span>
    <span class="about-dot about-dot-right-down"></span>
    <span class="about-dot about-dot-left-up"></span>
    <span class="about-dot about-dot-left-down"></span>

    <div class="about-left">
      <span>Trajetória</span>
      <h2>FORMAÇÃO JURÍDICA <strong>E OLHAR INTERDISCIPLINAR</strong></h2>
      <p>
        Advogado inscrito na OAB/SE nº 14.418, bacharel em Direito, pós-graduado
        em Direito Público e com formação complementar em Inventário e Partilha
        pela JusPodivm. Sua trajetória também reúne formação nas áreas de Letras
        e Educação.
      </p>
      <ul>
        <li>
          <strong>Bacharel em Direito • Faculdade Pio Décimo</strong>
          <span>2019</span>
        </li>
        <li>
          <strong>Pós-graduação em Direito Público</strong>
          <span>2021</span>
        </li>
        <li>
          <strong
            >Inventário e Partilha • Formação complementar • JusPodivm</strong
          >
          <span>2024</span>
        </li>
        <li>
          <strong>Graduação em Letras • Formação interdisciplinar</strong>
          <span>2025</span>
        </li>
      </ul>
    </div>
    <div class="about-right">
      <h3>GLADSON CONCEIÇÃO</h3>
      <p>Advogado • OAB/SE 14.418</p>
    </div>

    <div class="about-tags">
      <div class="about-tag">Base Jurídica</div>
      <div class="about-tag is-active">Foco Sucessório</div>
      <div class="about-tag">Visão Interdisciplinar</div>
    </div>
  </div>
</section>

<style>
  .about-gladson {
    padding-block: 80px;
    background: var(--color-primary);
    color: var(--color-background);
    overflow: hidden;
    position: relative;
  }

  .about-gladson :global(img) {
    width: 900px;
    height: auto;
    position: absolute;
    top: -140px;
    left: 50%;
    transform: translateX(-60%);
    z-index: 2;
  }

  .about-name {
    position: absolute;
    font-size: 450px;
    font-weight: 600;
    z-index: 1;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    opacity: 5%;
    line-height: 0.75;
  }

  .about-overlay {
    position: absolute;
    width: 50%;
    height: 100%;
    left: 0;
    top: 0;
    z-index: 3;

    background: rgba(27, 59, 52, 0.2);
    backdrop-filter: blur(20px);
  }

  .about-container {
    display: flex;
    justify-content: center;
    z-index: 4;
    position: relative;

    border: 1px solid rgba(246, 241, 232, 0.15);
  }

  .about-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background-color: var(--color-primary);
    border: 1px solid rgba(246, 241, 232, 0.2);
    position: absolute;
  }

  .about-dot-right-up {
    right: -5px;
    top: -5px;
  }

  .about-dot-right-down {
    right: -5px;
    bottom: -5px;
    z-index: 2;
  }

  .about-dot-left-up {
    left: -5px;
    top: -5px;
  }

  .about-dot-left-down {
    left: -5px;
    bottom: -5px;
    z-index: 2;
  }

  .about-left {
    flex: 1;
    max-width: 600px;
    padding-block: 74px;
    padding-inline: 56px;
  }

  .about-left > span {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding-inline: 16px;
    margin-bottom: 24px;

    border-radius: 999px;
    background: var(--color-primary-alt);

    font-size: 14px;
    color: rgba(246, 241, 232, 0.5);
  }

  .about-left > h2 {
    font-size: 36px;
    line-height: 40px;
    font-weight: 400;
    color: var(--color-background);
    margin-bottom: 16px;
  }

  .about-left > h2 > strong {
    display: block;
    font-weight: 400;
  }

  .about-left > p {
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 300;
    max-width: 470px;
    margin-bottom: 56px;
    opacity: 60%;
  }

  .about-left > ul {
    list-style: none;
  }

  .about-left > ul > li {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .about-left > ul > li::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 1px;
    background-color: var(--color-background);
    opacity: 15%;
    bottom: -6px;
  }

  .about-left > ul > li > strong {
    text-transform: uppercase;
    font-size: 13px;
    font-weight: 300;
    opacity: 60%;
  }

  .about-left > ul > li > span {
    font-size: 14px;
    font-weight: 600;
  }

  .about-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex: 1;
    padding: 16px;
    max-width: 600px;
    align-self: flex-end;
    position: relative;
  }

  .about-right > h3 {
    font-size: 36px;
    font-weight: 400;
  }

  .about-right > p {
    text-transform: uppercase;
    font-weight: 300;
    opacity: 60%;
  }

  .about-right::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 1px;
    background-color: var(--color-background);
    opacity: 50%;
    right: 0;
    bottom: -1px;
  }

  .about-right::after {
    content: "";
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background-color: var(--color-background);
    border: 4px solid transparent;
    background-clip: padding-box;
    box-shadow: 0 0 0 1px #f6f1e8;
    left: -11px;
    bottom: -9px;
  }

  .about-tags {
    position: absolute;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .about-tag {
    width: fit-content;
    padding-block: 8px;
    padding-inline: 16px;
    border-radius: 999px;

    border: 1px solid rgba(246, 241, 232, 0.15);
    font-size: 14px;
    font-weight: 300;
    text-transform: uppercase;
    color: rgba(246, 241, 232, 0.5);
  }
</style>
