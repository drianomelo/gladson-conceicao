---
import brazilMap from "../assets/images/brazil-map.svg";
import logoGladson from "../assets/icons/logo-gladson-black.png";
import iconLocation from "../assets/icons/location.svg";
import iconMap from "../assets/icons/map.svg";
import iconGlobe from "../assets/icons/globe.svg";
---

<section class="attendance" aria-labelledby="attendance-title">
  <div class="container attendance-layout">
    <div class="attendance-content">
      <span class="attendance-label">Atendimento</span>

      <h2 id="attendance-title"><span>Sergipe</span> e todo o Brasil</h2>

      <p>
        Atuação jurídica com atendimento presencial e remoto para questões
        sucessórias, com clareza, praticidade e proximidade em cada etapa.
      </p>

      <a
        href="https://wa.me/5579988697480?text=Ol%C3%A1%2C%20Dr.%20Gladson.%20Gostaria%20de%20conversar%20sobre%20uma%20quest%C3%A3o%20relacionada%20ao%20Direito%20Sucess%C3%B3rio."
        target="_blank"
        rel="noopener noreferrer"
      >
        Falar pelo WhatsApp

        <span>
          <img src={logoGladson.src} alt="" width="24" height="13" />
        </span>
      </a>
    </div>

    <div class="attendance-map" aria-hidden="true">
      <img src={brazilMap.src} alt="" width="480" height="480" />
    </div>

    <div class="attendance-info">
      <div>
        <span>
          <img src={iconLocation.src} alt="" width="16" height="18" />
        </span>
        <strong>Sergipe</strong>
        <p>Atuação principal e atendimento presencial.</p>
      </div>

      <div>
        <span>
          <img src={iconMap.src} alt="" width="16" height="16" />
        </span>
        <strong>Brasil</strong>
        <p>Atendimento remoto em todo o território nacional.</p>
      </div>

      <div>
        <span>
          <img src={iconGlobe.src} alt="" width="16" height="16" />
        </span>
        <strong>Online</strong>
        <p>Orientação e acompanhamento com praticidade à distância.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .attendance {
    padding-block: 80px;
    background: var(--color-background);
  }

  .attendance-layout {
    display: flex;
    justify-content: space-between;
  }

  .attendance-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 290px;
  }

  .attendance-label {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding-inline: 16px;
    margin-bottom: 24px;

    border-radius: 999px;
    background: var(--color-white);

    font-size: 14px;
    color: rgba(28, 28, 28, 0.5);
  }

  .attendance-content h2 {
    display: flex;
    flex-direction: column;
    text-transform: uppercase;

    font-size: 34px;
    line-height: 34px;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .attendance-content h2 > span {
    font-size: 64px;
    line-height: 60px;
    font-weight: 700;
  }

  .attendance-content > p {
    max-width: 330px;
    margin-bottom: 24px;

    font-size: 14px;
    font-weight: 300;
    line-height: 1.3;
    color: rgba(28, 28, 28, 0.6);
  }

  .attendance-content > a {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 60px;
    padding-left: 24px;
    padding-right: 5px;

    color: var(--color-background);
    background-color: var(--color-primary-alt);
    border-radius: 999px;
    font-size: 14px;

    transition: opacity 180ms ease;
  }

  .attendance-content > a:hover {
    opacity: 0.9;
  }

  .attendance-content a > span {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 52px;
    width: 52px;

    background-color: var(--color-background);
    border-radius: 999px;
  }

  .attendance-content a > span > img {
    width: 24px;
    height: auto;
    flex-shrink: 0;
  }

  .attendance-map {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .attendance-map img {
    width: 100%;
    max-width: 550px;
    height: auto;
  }

  .attendance-info {
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .attendance-info > div {
    display: flex;
    flex-direction: column;
    background: rgba(232, 223, 209, 0.4);
    padding: 10px 12px;
    border: 1px solid rgba(232, 223, 209, 0.5);
    border-radius: 8px;
  }

  .attendance-info > div > span {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 32px;
    height: 32px;
    background-color: var(--color-primary-alt);
    border-radius: 4px;
  }

  .attendance-info strong {
    display: block;
    text-transform: uppercase;
    font-size: 28px;
    margin-top: 4px;
    font-weight: 700;
  }

  .attendance-info p {
    max-width: 190px;

    font-size: 13px;
    line-height: 1.3;
    color: rgba(28, 28, 28, 0.5);
  }

  @media (max-width: 1000px) {
    .attendance {
      padding-block: 64px;
    }

    .attendance-layout {
      display: grid;
      grid-template-columns: minmax(240px, 0.8fr) minmax(320px, 1.2fr);
      gap: 40px;
    }

    .attendance-map {
      justify-content: flex-end;
    }

    .attendance-info {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: stretch;
      gap: 16px;
    }

    .attendance-info > div {
      flex: 1;
    }
  }

  @media (max-width: 700px) {
    .attendance {
      padding-block: 48px;
    }

    .attendance-layout {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .attendance-content {
      max-width: 100%;
    }

    .attendance-label {
      height: 36px;
      margin-bottom: 20px;
      font-size: 12px;
    }

    .attendance-content h2 {
      font-size: clamp(28px, 9vw, 34px);
      line-height: 1;
    }

    .attendance-content h2 > span {
      font-size: clamp(52px, 17vw, 64px);
      line-height: 0.95;
    }

    .attendance-content > p {
      max-width: 480px;
    }

    .attendance-content > a {
      width: 100%;
      max-width: 320px;
      justify-content: space-between;
    }

    .attendance-map {
      order: 3;
    }

    .attendance-map img {
      max-width: 420px;
      margin-inline: auto;
    }

    .attendance-info {
      order: 2;
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .attendance-info p {
      max-width: none;
    }
  }
</style>
