---
import logoGladson from "../assets/icons/logo-gladson-black.png";
import arrowIcon from "../assets/icons/arrow-up-right.svg";

const navItems = [
  { label: "Início", href: "#inicio" },
  { label: "Serviços", href: "#servicos" },
  { label: "Sobre", href: "#sobre" },
  { label: "Contato", href: "#contato" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Gladson Conceição - Página inicial">
      <img
        src={logoGladson.src}
        alt=""
        class="brand-symbol"
        width="76"
        height="50"
      />

      <div class="brand-text">
        <strong>Gladson Conceição</strong>
        <span>Advogado</span>
      </div>
    </a>

    <nav aria-label="Navegação principal">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-contact">
      <a class="phone" href="tel:+5579988697480"> (79) 98869-7480</a>

      <a
        class="contact-button"
        href="https://wa.me/5579988697480"
        target="_blank"
        rel="noopener noreferrer"
      >
        Fale comigo

        <img
          src={arrowIcon.src}
          alt=""
          aria-hidden="true"
          width="10"
          height="10"
        />
      </a>

      <details class="mobile-nav">
        <summary aria-label="Abrir menu de navegação">
          <span></span>
          <span></span>
          <span></span>
        </summary>

        <nav aria-label="Navegação para dispositivos móveis">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    padding-block: 16px;
    padding-inline: 24px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .brand-symbol {
    width: 76px;
    height: auto;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-text strong {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
  }

  .brand-text span {
    font-size: 16px;
    font-weight: 300;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 40px;
    list-style: none;
  }

  .nav-list a {
    display: flex;
    justify-content: center;
    position: relative;
    font-size: 16px;
    font-weight: 300;
    opacity: 60%;
    transition:
      opacity 180ms ease,
      background-color 180ms ease;
  }

  .nav-list a::after {
    content: "";
    position: absolute;
    bottom: -5px;
    width: 0;
    height: 1px;
    background: var(--color-text);
    transition: width 180ms ease;
  }

  .nav-list a:hover,
  .nav-list a:focus-visible {
    opacity: 100%;
  }

  .nav-list a:hover::after,
  .nav-list a:focus-visible::after {
    width: 110%;
  }

  .header-contact {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .phone {
    font-size: 16px;
    font-weight: 300;
  }

  .contact-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding-inline: 20px;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-background);
    font-size: 14px;
    font-weight: 500;
    transition:
      opacity 180ms ease,
      background-color 180ms ease;
  }

  .contact-button img {
    margin-top: 1px;
  }

  .contact-button:hover,
  .contact-button:focus-visible {
    background: var(--color-primary-alt);
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 1200px) {
    .site-header {
      padding-inline: 20px;
    }

    .header-inner {
      gap: 24px;
    }

    .brand-symbol {
      width: 64px;
    }

    .brand-text strong {
      font-size: 18px;
    }

    .brand-text span {
      font-size: 14px;
    }

    .nav-list {
      gap: 24px;
    }

    .nav-list a,
    .phone {
      font-size: 14px;
    }

    .contact-button {
      padding-inline: 16px;
    }
  }

  @media (max-width: 900px) {
    .site-header nav,
    .phone {
      display: none;
    }

    .header-inner {
      gap: 16px;
    }

    .mobile-nav {
      display: block;
      position: relative;
    }

    .mobile-nav summary {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 40px;
      height: 40px;
      padding-inline: 10px;
      border: 1px solid rgba(28, 28, 28, 0.18);
      border-radius: 50%;
      cursor: pointer;
      list-style: none;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav summary span {
      width: 100%;
      height: 1px;
      background: var(--color-text);
      transition: transform 180ms ease;
    }

    .mobile-nav[open] summary span:first-child {
      transform: translateY(5px) rotate(45deg);
    }

    .mobile-nav[open] summary span:nth-child(2) {
      opacity: 0;
    }

    .mobile-nav[open] summary span:last-child {
      transform: translateY(-5px) rotate(-45deg);
    }

    .mobile-nav nav {
      position: absolute;
      z-index: 20;
      top: calc(100% + 10px);
      right: 0;
      display: flex;
      flex-direction: column;
      min-width: 180px;
      padding: 8px;
      border: 1px solid rgba(28, 28, 28, 0.12);
      border-radius: 14px;
      background: var(--color-background);
      box-shadow: 0 16px 40px rgba(16, 42, 36, 0.16);
    }

    .mobile-nav nav a {
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 14px;
    }

    .mobile-nav nav a:hover,
    .mobile-nav nav a:focus-visible {
      background: var(--color-white);
    }
  }

  @media (max-width: 600px) {
    .site-header {
      padding: 12px 16px;
    }

    .brand-symbol {
      width: 58px;
    }

    .brand-text strong {
      font-size: 16px;
    }

    .brand-text span {
      font-size: 12px;
    }

    .contact-button {
      min-height: 38px;
      padding-inline: 14px;
      font-size: 12px;
    }

    .header-contact {
      gap: 8px;
    }

    .mobile-nav summary {
      width: 38px;
      height: 38px;
    }
  }

  @media (max-width: 420px) {
    .brand-text {
      display: none;
    }

    .contact-button {
      padding-inline: 12px;
    }
  }
</style>
