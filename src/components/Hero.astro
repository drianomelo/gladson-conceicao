---
import { Image } from "astro:assets";

import heroBg from "../assets/images/hero-bg.webp";
import gladsonHero from "../assets/images/hero-gladson.png";
import arrowIcon from "../assets/icons/arrow-long-down.svg";

import patrimonio from "../assets/images/hero-tag-1.webp";
import familia from "../assets/images/hero-tag-2.webp";
import documento from "../assets/images/hero-tag-3.webp";
---

<section class="hero" id="inicio">
  <div class="hero-overlay"></div>

  <Image src={heroBg} alt="" class="hero-bg" loading="eager" />

  <div class="hero-inner">
    <div>
      <h1>Direito Sucessório</h1>

      <div class="hero-copy">
        <div class="hero-copy-left">
          <p>
            Orientação jurídica em inventários, planejamento sucessório e
            organização patrimonial, com atendimento claro e personalizado.
          </p>
        </div>

        <div class="hero-copy-right">
          <p>
            Atuação em Sergipe e atendimento em todo o Brasil para questões
            relacionadas à sucessão e patrimônio.
          </p>
        </div>
      </div>
    </div>

    <div class="hero-bottom">
      <div class="hero-pills">
        <span>Inventários</span>
        <span>Planejamento Sucessório</span>
        <span>Testamentos</span>
        <span>Doações</span>
      </div>

      <a href="#servicos">
        Conheça nossa atuação
        <span>
          <img
            src={arrowIcon.src}
            alt=""
            aria-hidden="true"
            width="17"
            height="14"
          />
        </span>
      </a>
    </div>
  </div>

  <div class="hero-lawyer">
    <Image
      src={gladsonHero}
      alt="Gladson Conceição, advogado"
      width={780}
      quality={90}
      format="webp"
      loading="eager"
    />

    <div class="hero-tag hero-tag-services">
      <div class="tag-images">
        <Image src={documento} alt="" width={36} height={36} />
        <Image src={patrimonio} alt="" width={36} height={36} />
        <Image src={familia} alt="" width={36} height={36} />
      </div>

      <div>
        <strong>Direito Sucessório</strong>
        <span>Planejamento • Inventário • Partilha</span>
      </div>
    </div>

    <div class="hero-tag hero-tag-lawyer">
      <strong>Gladson Conceição dos Santos</strong>
      <span>Advogado • OAB/SE 14.418</span>
    </div>
  </div>
</section>

<style>
  .hero {
    margin-inline: 20px;
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    container-type: inline-size;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-primary);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;

    width: 100%;
    height: 100%;
    object-fit: cover;

    filter: blur(4px);
    opacity: 10%;
  }

  .hero-inner {
    position: relative;
    z-index: 2;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    min-height: clamp(620px, 54.3cqw, 760px);
    padding-inline: 24px;
    padding-block: 32px;

    container-type: inline-size;
  }

  .hero h1 {
    font-family: var(--font-serif);

    font-size: min(9.35cqw, 171px);

    font-weight: 400;
    line-height: 0.8;
    letter-spacing: 0.0815em;

    white-space: nowrap;
    width: 100%;
    max-width: 100%;
    margin-bottom: 24px;
    color: var(--color-background);
  }

  .hero-lawyer {
    position: absolute;
    z-index: 3;

    left: 50%;
    top: -10px;
    transform: translateX(-50%);

    width: clamp(650px, 55.7cqw, 780px);
  }

  .hero-lawyer :global(img) {
    width: 100%;
    max-width: none;
    height: auto;
  }

  .hero-copy {
    display: flex;
    justify-content: space-between;
    color: var(--color-background);
    font-size: 18px;
    line-height: 23px;
    font-weight: 300;
    opacity: 50%;
  }

  .hero-copy-left {
    width: 440px;
  }

  .hero-copy-right {
    width: 405px;
    text-align: right;
  }

  .hero-tag {
    position: absolute;
    z-index: 3;

    display: flex;
    align-items: center;
    gap: 8px;
    height: 60px;

    padding-inline: 10px;
    border: 1px solid rgba(246, 241, 232, 0.15);
    border-radius: 5px;

    background: rgba(246, 241, 232, 0.2);
    backdrop-filter: blur(20px);

    color: var(--color-background);
  }

  .hero-tag strong,
  .hero-tag span {
    display: block;
    line-height: 1.05;
  }

  .hero-tag strong {
    font-size: 13px;
    font-weight: 400;
  }

  .hero-tag span {
    margin-top: 2px;
    font-size: 11px;
    opacity: 0.6;
  }

  .hero-tag-services {
    left: 0;
    top: 52%;
    transform: translateX(-8%);
  }

  .hero-tag-lawyer {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0;

    right: 0;
    top: 42%;
  }

  .tag-images {
    display: flex;
  }

  .tag-images :global(img) {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(246, 241, 232, 0.3);
  }

  .tag-images :global(img:not(:first-child)) {
    margin-left: -15px;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;

    color: var(--color-background);
  }

  .hero-pills {
    width: 300px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hero-pills span {
    display: flex;
    align-items: center;
    padding-inline: 32px;
    height: 40px;

    border: 1px solid rgba(246, 241, 232, 0.5);
    border-radius: 999px;

    background: rgba(246, 241, 232, 0.25);

    font-size: 14px;
  }

  .hero-bottom a {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 14px;
  }

  .hero-bottom a span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    border: 1px solid rgba(246, 241, 232, 0.5);
    border-radius: 999px;
  }

  @media (max-width: 1200px) {
    .hero-copy {
      font-size: 15px;
      line-height: 1.4;
    }

    .hero-copy-left {
      width: 340px;
    }

    .hero-copy-right {
      width: 320px;
    }

    .hero h1 {
      font-size: min(9.2cqw, 110px);
    }

    .hero-lawyer {
      width: clamp(610px, 62cqw, 720px);
    }

    .hero-pills {
      width: 280px;
    }

    .hero-pills span {
      height: 36px;
      padding-inline: 20px;
      font-size: 12px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      margin-inline: 16px;
      border-radius: 20px;
    }

    .hero-inner {
      z-index: 3;
      min-height: 680px;
      padding: 28px 20px;
    }

    .hero h1 {
      font-size: min(9.1cqw, 76px);
      letter-spacing: 0.065em;
    }

    .hero-lawyer {
      z-index: 2;
      top: 50px;
      width: 600px;
    }

    .hero-copy {
      display: block;

      font-size: 14px;
      line-height: 1.45;
    }

    .hero-copy-left {
      width: 300px;
    }

    .hero-copy-right {
      display: none;
    }

    .hero-tag-services {
      top: 48%;
    }

    .hero-tag-lawyer {
      top: 40%;
    }

    .hero-bottom {
      position: relative;
      z-index: 4;
    }

    .hero-pills {
      width: 260px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      margin-inline: 10px;
      border-radius: 18px;
    }

    .hero-inner {
      min-height: 640px;
      padding: 24px 16px;
    }

    .hero h1 {
      font-size: clamp(27px, 9.2cqw, 50px);
      line-height: 0.95;
      letter-spacing: 0.04em;
      text-align: center;
    }

    .hero-lawyer {
      top: 82px;
      width: 500px;
    }

    .hero-copy {
      font-size: 13px;
    }

    .hero-copy-left {
      width: min(270px, 80%);
    }

    .hero-tag-services {
      display: none;
    }

    .hero-tag-lawyer {
      right: 96px;
      top: 300px;

      height: 52px;
    }

    .hero-tag-lawyer strong {
      font-size: 11px;
    }

    .hero-tag-lawyer span {
      font-size: 9px;
    }

    .hero-bottom {
      display: flex;
      justify-content: flex-end;
    }

    .hero-pills {
      display: none;
    }

    .hero-bottom a {
      font-size: 12px;
    }
  }

  @media (max-width: 380px) {
    .hero-lawyer {
      left: 53%;
      width: 470px;
    }

    .hero-tag-lawyer {
      right: 86px;
    }
  }
</style>
