---
import logoGladson from "../assets/icons/logo-white.svg";
import heroBg from "../assets/images/hero-bg.webp";
import iconCheck from "../assets/icons/check.svg";

import { Image } from "astro:assets";
---

<section class="main-services" id="servicos" aria-labelledby="services-title">
  <div class="container">
    <div class="services-header">
      <span>Principais Áreas</span>

      <div class="services-title">
        <h2 id="services-title">
          Atuação focada nos principais momentos da sucessão
        </h2>

        <p>
          Do planejamento patrimonial em vida à condução do inventário após o
          falecimento.
        </p>
      </div>
    </div>

    <div class="services-content">
      <div class="services-list">
        <button type="button" class="service-item" data-service="planejamento">
          <span>01</span>
          <strong>Planejamento Sucessório</strong>
        </button>

        <button
          type="button"
          class="service-item is-active"
          data-service="inventarios"
        >
          <span>02</span>
          <strong>Inventários</strong>
        </button>

        <div class="services-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="services-more">
          <a href="/areas-de-atuacao">
            Explorar áreas de atuação
            <span>
              <img src={logoGladson.src} alt="" width="24" height="13" />
            </span>
          </a>
        </div>
      </div>

      <div class="services-display">
        <div class="services-display-header">
          <p>Condução segura do inventário</p>
          <Image
            src={heroBg}
            alt="Documentos relacionados à condução de inventário"
            width={592}
            height={444}
            quality={85}
          />
          <div class="services-overlay"></div>
        </div>
        <div class="services-display-footer">
          <p>
            Atuação em inventários, com orientação jurídica para regularização e
            partilha do patrimônio após o falecimento, buscando condução clara,
            segura e responsável em cada etapa.
          </p>
          <a
            href="https://wa.me/5579988697480?text=Ol%C3%A1%2C%20Dr.%20Gladson.%20Gostaria%20de%20receber%20orienta%C3%A7%C3%A3o%20sobre%20invent%C3%A1rio."
            target="_blank"
            rel="noopener noreferrer"
          >
            Entre em contato
          </a>
        </div>
        <div class="services-display-tag">
          <p>Inventários</p>
          <ul>
            <li>
              <span>
                <img src={iconCheck.src} alt="" width="8" height="5" />
              </span>
              Regularização
            </li>
            <li>
              <span>
                <img src={iconCheck.src} alt="" width="8" height="5" />
              </span>
              Partilha
            </li>
            <li>
              <span>
                <img src={iconCheck.src} alt="" width="8" height="5" />
              </span>
              Condução jurídica
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .main-services {
    background-color: var(--color-primary);
    padding-block: 80px;
  }

  .services-header {
    margin-bottom: 48px;
  }

  .services-header span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: 16px;
    width: fit-content;
    margin-bottom: 24px;

    background-color: var(--color-primary-alt);
    border-radius: 999px;
    font-size: 14px;
    color: rgba(246, 241, 232, 0.5);
  }

  .services-title {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .services-title h2 {
    max-width: 760px;
    font-size: 48px;
    font-weight: 500;
    line-height: 50px;

    color: var(--color-background);
  }

  .services-title p {
    width: 300px;
    font-size: 15px;
    color: var(--color-background);
    opacity: 50%;
  }

  .services-content {
    display: flex;
    gap: 16px;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    gap: 16px;
  }

  .service-item {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 116px;
    padding-inline: 32px;
    padding-block: 20px;
    overflow: hidden;
    width: 100%;

    font-family: var(--font-sans);
    background-color: var(--color-primary-alt);
    border: 0;
    border-radius: 28px;

    cursor: pointer;
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .service-item span {
    font-size: 140px;
    font-weight: 600;
    line-height: 0.8;
    margin-bottom: -50px;
    color: var(--color-background);
    opacity: 10%;
  }

  .service-item strong {
    font-size: 20px;

    color: var(--color-background);
    opacity: 40%;
    font-weight: 400;
  }

  .service-item.is-active span,
  .service-item.is-active strong {
    opacity: 1;
  }

  .service-item:hover {
    transform: scale(1.02);
  }

  .services-dots {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 48px;
  }

  .services-dots span {
    width: 10px;
    height: 10px;

    background-color: var(--color-background);
    border-radius: 100px;
    opacity: 20%;
  }

  .services-more a {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 60px;
    padding-left: 24px;
    padding-right: 5px;

    background-color: var(--color-background);
    border-radius: 999px;
    font-size: 14px;

    transition: all 180ms ease;
  }

  .services-more a:hover {
    background-color: var(--color-white);
  }

  .services-more a span {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 52px;
    width: 52px;

    background-color: var(--color-text);
    border-radius: 999px;
  }

  .services-more a span img {
    width: 24px;
    height: auto;
    flex-shrink: 0;
  }

  .services-display {
    position: relative;
    flex: 1;
    background-color: var(--color-primary-alt);
    border-radius: 28px;
  }

  .services-display-header {
    display: flex;
    align-items: flex-end;
    position: relative;
    overflow: hidden;
    height: 60%;
    border-radius: 28px;
    padding: 32px;
  }

  .services-display-header p {
    position: relative;
    margin-right: 100px;
    z-index: 3;

    font-size: 46px;
    font-weight: 500;
    line-height: 46px;
    color: var(--color-background);
  }

  .services-display-header img {
    position: absolute;
    left: 0;
    top: -40%;
  }

  .services-overlay {
    position: absolute;
    z-index: 2;
    inset: 0;

    background: linear-gradient(to top, var(--color-primary), transparent);
  }

  .services-display-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 40%;
    padding: 32px;
  }

  .services-display-footer p {
    width: 65%;
    color: var(--color-background);
    font-weight: 300;
    font-size: 15px;
    opacity: 50%;
  }

  .services-display-footer a {
    display: flex;
    align-items: center;
    background-color: var(--color-accent);
    color: var(--color-background);
    font-size: 14px;
    height: 40px;
    padding-inline: 16px;
    border-radius: 999px;
  }

  .services-display-tag {
    position: absolute;
    z-index: 4;
    right: 32px;
    top: 48%;
    width: 215px;
    background-color: var(--color-primary);
    border-radius: 16px;
    border: 1px solid rgba(246, 241, 232, 0.1);
    padding-block: 16px;
    padding-inline: 20px;
  }

  .services-display-tag p {
    color: var(--color-background);
    font-weight: 600;
    font-size: 24px;
    margin-bottom: 6px;
  }

  .services-display-tag ul {
    display: flex;
    flex-direction: column;
    gap: 5px;
    list-style: none;
    padding-left: 4px;
  }

  .services-display-tag ul li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(246, 241, 232, 0.5);
  }

  .services-display-tag ul li span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background-color: var(--color-accent);
  }
</style>
