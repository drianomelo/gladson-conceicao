---
import logoGladson from "../assets/icons/logo-gladson-black-hd.png";
import heroBg from "../assets/images/hero-bg.webp";
import iconCheck from "../assets/icons/check.svg";

import { Image } from "astro:assets";
---

<section class="main-services" id="servicos" aria-labelledby="services-title">
  <div class="container">
    <div class="services-header">
      <span>Principais Áreas</span>

      <div class="services-title">
        <h2 id="services-title">
          Atuação focada nos principais momentos da sucessão
        </h2>

        <p>
          Do planejamento patrimonial em vida à condução do inventário após o
          falecimento.
        </p>
      </div>
    </div>

    <div class="services-content">
      <div class="services-list">
        <div class="services-tabs" role="tablist" aria-label="Áreas principais">
          <button
            type="button"
            class="service-item"
            id="service-tab-planejamento"
            data-service="planejamento"
            role="tab"
            aria-controls="service-panel"
            aria-selected="false"
            tabindex="-1"
          >
            <span>01</span>
            <strong>Planejamento Sucessório</strong>
          </button>

          <button
            type="button"
            class="service-item is-active"
            id="service-tab-inventarios"
            data-service="inventarios"
            role="tab"
            aria-controls="service-panel"
            aria-selected="true"
          >
            <span>02</span>
            <strong>Inventários</strong>
          </button>
        </div>

        <div class="services-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="services-more">
          <a href="/areas-de-atuacao">
            Explorar áreas de atuação
            <span>
              <img src={logoGladson.src} alt="" width="24" height="13" />
            </span>
          </a>
        </div>
      </div>

      <div
        class="services-display"
        id="service-panel"
        role="tabpanel"
        aria-labelledby="service-tab-inventarios"
      >
        <div class="services-display-header">
          <p data-service-heading>Condução segura do inventário</p>
          <Image
            src={heroBg}
            alt="Documentos relacionados à condução de inventário"
            data-service-image
            width={592}
            height={444}
            widths={[480, 592]}
            sizes="(max-width: 760px) calc(100vw - 32px), 592px"
            quality={85}
          />
          <div class="services-overlay"></div>
        </div>
        <div class="services-display-footer">
          <p data-service-description>
            Atuação em inventários, com orientação jurídica para regularização e
            partilha do patrimônio após o falecimento, buscando condução clara,
            segura e responsável em cada etapa.
          </p>
          <a
            href="https://wa.me/5579988697480?text=Ol%C3%A1%2C%20Dr.%20Gladson.%20Gostaria%20de%20receber%20orienta%C3%A7%C3%A3o%20sobre%20invent%C3%A1rio."
            target="_blank"
            rel="noopener noreferrer"
            data-service-contact
          >
            Entre em contato
          </a>
        </div>
        <div class="services-display-tag">
          <p data-service-title>Inventários</p>
          <ul>
            <li>
              <span class="benefit-check">
                <img src={iconCheck.src} alt="" width="8" height="5" />
              </span>
              <span data-service-benefit>Regularização</span>
            </li>
            <li>
              <span class="benefit-check">
                <img src={iconCheck.src} alt="" width="8" height="5" />
              </span>
              <span data-service-benefit>Partilha</span>
            </li>
            <li>
              <span class="benefit-check">
                <img src={iconCheck.src} alt="" width="8" height="5" />
              </span>
              <span data-service-benefit>Condução jurídica</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .main-services {
    background-color: var(--color-primary);
    padding-block: 80px;
  }

  .services-header {
    margin-bottom: 48px;
  }

  .services-header span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: 16px;
    width: fit-content;
    margin-bottom: 24px;

    background-color: var(--color-primary-alt);
    border-radius: 999px;
    font-size: 14px;
    color: rgba(246, 241, 232, 0.5);
  }

  .services-title {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .services-title h2 {
    max-width: 760px;
    font-size: 48px;
    font-weight: 500;
    line-height: 50px;

    color: var(--color-background);
  }

  .services-title p {
    width: 300px;
    font-size: 15px;
    color: var(--color-background);
    opacity: 50%;
  }

  .services-content {
    display: flex;
    gap: 16px;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    gap: 16px;
  }

  .services-tabs {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .service-item {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 116px;
    padding-inline: 32px;
    padding-block: 20px;
    overflow: hidden;
    width: 100%;

    font-family: var(--font-sans);
    background-color: var(--color-primary-alt);
    border: 0;
    border-radius: 28px;

    cursor: pointer;
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .service-item span {
    font-size: 140px;
    font-weight: 600;
    line-height: 0.8;
    margin-bottom: -50px;
    color: var(--color-background);
    opacity: 10%;
  }

  .service-item strong {
    font-size: 20px;

    color: var(--color-background);
    opacity: 40%;
    font-weight: 400;
    transition: opacity 180ms ease;
  }

  .service-item span {
    transition: opacity 180ms ease;
  }

  .service-item.is-active span,
  .service-item.is-active strong {
    opacity: 1;
  }

  .service-item:hover,
  .service-item:focus-visible {
    transform: scale(1.02);
  }

  .service-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .services-dots {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 48px;
  }

  .services-dots span {
    width: 10px;
    height: 10px;

    background-color: var(--color-background);
    border-radius: 100px;
    opacity: 20%;
  }

  .services-more a {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 60px;
    padding-left: 24px;
    padding-right: 5px;

    background-color: var(--color-background);
    border-radius: 999px;
    font-size: 14px;

    transition: background-color 180ms ease;
  }

  .services-more a:hover {
    background-color: var(--color-white);
  }

  .services-more a span {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 52px;
    width: 52px;

    background-color: var(--color-text);
    border-radius: 999px;
  }

  .services-more a span img {
    width: 24px;
    height: auto;
    flex-shrink: 0;
    filter: brightness(0) invert(1);
  }

  .services-display {
    position: relative;
    flex: 1;
    background-color: var(--color-primary-alt);
    border-radius: 28px;
  }

  .services-display-header {
    display: flex;
    align-items: flex-end;
    position: relative;
    overflow: hidden;
    height: 60%;
    border-radius: 28px;
    padding: 32px;
  }

  .services-display-header p {
    position: relative;
    margin-right: 100px;
    z-index: 3;

    font-size: 46px;
    font-weight: 500;
    line-height: 46px;
    color: var(--color-background);
  }

  .services-display-header img {
    position: absolute;
    left: 0;
    top: -40%;
  }

  .services-overlay {
    position: absolute;
    z-index: 2;
    inset: 0;

    background: linear-gradient(to top, var(--color-primary), transparent);
  }

  .services-display-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 40%;
    padding: 32px;
  }

  .services-display-footer p {
    width: 65%;
    color: var(--color-background);
    font-weight: 300;
    font-size: 15px;
    opacity: 50%;
  }

  .services-display-footer a {
    display: flex;
    align-items: center;
    background-color: var(--color-accent);
    color: var(--color-background);
    font-size: 14px;
    height: 40px;
    padding-inline: 16px;
    border-radius: 999px;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .services-display-footer a:hover,
  .services-display-footer a:focus-visible {
    background-color: #b99a70;
    transform: translateY(-2px);
  }

  .services-display-tag {
    position: absolute;
    z-index: 4;
    right: 32px;
    top: 48%;
    width: 215px;
    background-color: var(--color-primary);
    border-radius: 16px;
    border: 1px solid rgba(246, 241, 232, 0.1);
    padding-block: 16px;
    padding-inline: 20px;
  }

  .services-display-tag p {
    color: var(--color-background);
    font-weight: 600;
    font-size: 24px;
    margin-bottom: 6px;
  }

  .services-display-tag ul {
    display: flex;
    flex-direction: column;
    gap: 5px;
    list-style: none;
    padding-left: 4px;
  }

  .services-display-tag ul li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(246, 241, 232, 0.5);
  }

  .services-display-tag .benefit-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background-color: var(--color-accent);
  }

  @media (max-width: 1000px) {
    .main-services {
      padding-block: 64px;
    }

    .services-title {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .services-title h2 {
      max-width: 720px;
      font-size: clamp(40px, 6vw, 48px);
      line-height: 1.08;
    }

    .services-title p {
      width: min(100%, 460px);
      line-height: 1.5;
    }

    .services-content {
      flex-direction: column;
      gap: 24px;
    }

    .services-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services-tabs {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services-dots {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: center;
      padding-block: 12px;
    }

    .services-more {
      grid-column: 1 / -1;
      justify-self: center;
    }

    .services-display {
      min-height: 620px;
    }

    .services-display-header img {
      width: 100%;
      height: 100%;
      top: 0;
      object-fit: cover;
    }
  }

  @media (max-width: 600px) {
    .main-services {
      padding-block: 48px;
    }

    .services-header {
      margin-bottom: 32px;
    }

    .services-header span {
      height: 36px;
      margin-bottom: 20px;
      font-size: 12px;
    }

    .services-title h2 {
      font-size: clamp(32px, 10vw, 40px);
    }

    .services-title p {
      font-size: 14px;
    }

    .services-list {
      grid-template-columns: 1fr;
    }

    .services-tabs {
      grid-template-columns: 1fr;
    }

    .service-item {
      height: 92px;
      padding: 16px 20px;
      border-radius: 20px;
    }

    .service-item span {
      font-size: 104px;
      margin-bottom: -38px;
    }

    .service-item strong {
      max-width: 190px;
      font-size: 17px;
      text-align: right;
    }

    .services-display {
      min-height: 600px;
      border-radius: 20px;
    }

    .services-display-header {
      height: 320px;
      padding: 24px;
      border-radius: 20px;
    }

    .services-display-header p {
      margin-right: 0;
      padding-bottom: 52px;
      font-size: clamp(34px, 10vw, 42px);
      line-height: 1;
    }

    .services-display-footer {
      height: auto;
      min-height: 280px;
      padding: 88px 24px 24px;
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .services-display-footer p {
      width: 100%;
      font-size: 14px;
      line-height: 1.45;
    }

    .services-display-tag {
      top: 280px;
      right: 20px;
      width: calc(100% - 40px);
    }
  }
</style>

<script>
  interface ServiceContent {
    heading: string;
    description: string;
    title: string;
    benefits: [string, string, string];
    href: string;
    imageAlt: string;
  }

  const serviceContent: Record<string, ServiceContent> = {
    planejamento: {
      heading: "Organização estratégica do patrimônio",
      description:
        "Planejamento sucessório realizado em vida, com orientação jurídica para estruturar a transmissão do patrimônio, formalizar decisões e reduzir riscos de conflitos futuros.",
      title: "Planejamento Sucessório",
      benefits: [
        "Organização patrimonial",
        "Prevenção de conflitos",
        "Segurança jurídica",
      ],
      href: "https://wa.me/5579988697480?text=Ol%C3%A1%2C%20Dr.%20Gladson.%20Gostaria%20de%20receber%20orienta%C3%A7%C3%A3o%20sobre%20planejamento%20sucess%C3%B3rio.",
      imageAlt: "Documentos relacionados ao planejamento sucessório",
    },
    inventarios: {
      heading: "Condução segura do inventário",
      description:
        "Atuação em inventários, com orientação jurídica para regularização e partilha do patrimônio após o falecimento, buscando condução clara, segura e responsável em cada etapa.",
      title: "Inventários",
      benefits: ["Regularização", "Partilha", "Condução jurídica"],
      href: "https://wa.me/5579988697480?text=Ol%C3%A1%2C%20Dr.%20Gladson.%20Gostaria%20de%20receber%20orienta%C3%A7%C3%A3o%20sobre%20invent%C3%A1rio.",
      imageAlt: "Documentos relacionados à condução de inventário",
    },
  };

  document.querySelectorAll<HTMLElement>(".main-services").forEach((root) => {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-service]"),
    );
    const panel = root.querySelector<HTMLElement>("[role='tabpanel']");
    const heading = root.querySelector<HTMLElement>("[data-service-heading]");
    const description = root.querySelector<HTMLElement>(
      "[data-service-description]",
    );
    const title = root.querySelector<HTMLElement>("[data-service-title]");
    const benefits = Array.from(
      root.querySelectorAll<HTMLElement>("[data-service-benefit]"),
    );
    const contact = root.querySelector<HTMLAnchorElement>(
      "[data-service-contact]",
    );
    const image = root.querySelector<HTMLImageElement>("[data-service-image]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let panelAnimation: Animation | undefined;

    const activate = (tab: HTMLButtonElement) => {
      const content = serviceContent[tab.dataset.service ?? ""];
      if (!content || tab.getAttribute("aria-selected") === "true") return;

      tabs.forEach((item) => {
        const isActive = item === tab;
        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-selected", String(isActive));
        item.tabIndex = isActive ? 0 : -1;
      });

      if (panel) panel.setAttribute("aria-labelledby", tab.id);
      if (heading) heading.textContent = content.heading;
      if (description) description.textContent = content.description;
      if (title) title.textContent = content.title;
      if (contact) contact.href = content.href;
      if (image) image.alt = content.imageAlt;
      benefits.forEach((item, index) => {
        item.textContent = content.benefits[index] ?? "";
      });

      if (panel && !reduceMotion.matches) {
        panelAnimation?.cancel();
        panelAnimation = panel.animate(
          [
            { opacity: 0.65, transform: "translateY(8px)" },
            { opacity: 1, transform: "translateY(0)" },
          ],
          { duration: 260, easing: "cubic-bezier(.2,.8,.2,1)" },
        );
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        let targetIndex = index;
        if (event.key === "ArrowDown" || event.key === "ArrowRight") {
          targetIndex = (index + 1) % tabs.length;
        } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
          targetIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          targetIndex = 0;
        } else if (event.key === "End") {
          targetIndex = tabs.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        const targetTab = tabs[targetIndex];
        if (targetTab) {
          targetTab.focus();
          activate(targetTab);
        }
      });
    });
  });
</script>
