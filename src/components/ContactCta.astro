---
import arrowIcon from "../assets/icons/arrow-up-right.svg";

interface Props {
  title?: string;
  text?: string;
  subject?: string;
}

const {
  title = "Vamos compreender o seu caso?",
  text = "Entre em contato para explicar sua situação e receber orientação sobre os caminhos jurídicos possíveis.",
  subject = "uma questão de Direito Sucessório",
} = Astro.props;

const message = encodeURIComponent(
  `Olá, Dr. Gladson. Gostaria de conversar sobre ${subject}.`,
);
---

<section class="contact-cta" aria-labelledby="contact-cta-title">
  <div class="container contact-cta-inner" data-reveal="up">
    <div>
      <span>Próximo passo</span>
      <h2 id="contact-cta-title">{title}</h2>
    </div>
    <div class="contact-cta-action">
      <p>{text}</p>
      <a
        href={`https://wa.me/5579988697480?text=${message}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Conversar pelo WhatsApp
        <span><img src={arrowIcon.src} alt="" width="12" height="12" /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    padding-block: 24px 80px;
  }

  .contact-cta-inner {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 64px;
    padding: 56px;
    border-radius: 20px;
    background: var(--color-white);
  }

  .contact-cta-inner > div:first-child > span {
    display: block;
    margin-bottom: 18px;
    color: rgba(28, 28, 28, 0.5);
    font-size: 13px;
  }

  h2 {
    max-width: 650px;
    font-family: var(--font-serif);
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .contact-cta-action {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 24px;
  }

  .contact-cta-action p {
    max-width: 440px;
    color: rgba(28, 28, 28, 0.62);
    line-height: 1.6;
  }

  .contact-cta-action a {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    min-height: 58px;
    padding-left: 22px;
    padding-right: 5px;
    border-radius: 999px;
    background: var(--color-primary-alt);
    color: var(--color-background);
    font-size: 14px;
  }

  .contact-cta-action a > span {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-background);
  }

  .contact-cta-action a img {
    filter: brightness(0) saturate(100%);
    transition: transform 180ms ease;
  }

  .contact-cta-action a:hover img,
  .contact-cta-action a:focus-visible img {
    transform: translate(2px, -2px);
  }

  @media (max-width: 800px) {
    .contact-cta-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px;
    }
  }

  @media (max-width: 600px) {
    .contact-cta {
      padding-block: 8px 48px;
    }

    .contact-cta-inner {
      padding: 30px 22px;
      border-radius: 16px;
    }

    h2 {
      font-size: clamp(38px, 12vw, 50px);
    }

    .contact-cta-action a {
      justify-content: space-between;
      width: 100%;
    }
  }
</style>
