---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import InternalHero from "../../components/InternalHero.astro";
import ContactCta from "../../components/ContactCta.astro";
import ClosingSection from "../../components/ClosingSection.astro";
import arrowIcon from "../../assets/icons/arrow-right.svg";
import { services } from "../../data/services";

const title = "Áreas de Atuação | Gladson Conceição";
const description =
  "Conheça a atuação de Gladson Conceição em inventários, planejamento sucessório, testamentos, doações e consultoria sucessória.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <InternalHero
      eyebrow="Atuação jurídica"
      title="Áreas de atuação"
      description="Orientação jurídica dedicada às relações familiares e patrimoniais que envolvem a sucessão, com análise individualizada e comunicação clara."
      current="Áreas de atuação"
    />

    <section class="services-page" aria-labelledby="services-page-title">
      <div class="container">
        <div class="section-intro" data-reveal="up">
          <span>Direito Sucessório</span>
          <div>
            <h2 id="services-page-title">Cuidado jurídico em cada etapa</h2>
            <p>
              Da organização do patrimônio em vida à regularização após o
              falecimento, cada serviço parte da compreensão do contexto e das
              necessidades de quem busca orientação.
            </p>
          </div>
        </div>

        <div class="services-grid">
          {
            services.map((service) => (
              <article class="service-card" data-reveal="up">
                <div class="service-number" aria-hidden="true">
                  {service.number}
                </div>
                <div class="service-card-copy">
                  <span>{service.eyebrow}</span>
                  <h3>{service.title}</h3>
                  <p>{service.summary}</p>
                  <a href={`/areas-de-atuacao/${service.slug}`}>
                    Conhecer esta atuação
                    <img src={arrowIcon.src} alt="" width="12" height="12" />
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <ContactCta />
    <ClosingSection />
  </main>
</BaseLayout>

<style>
  .services-page {
    padding-block: 96px 72px;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 56px;
  }

  .section-intro > span {
    color: rgba(28, 28, 28, 0.48);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .section-intro > div {
    display: grid;
    grid-template-columns: 1fr 0.65fr;
    gap: 48px;
    align-items: end;
  }

  .section-intro h2 {
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .section-intro p {
    color: rgba(28, 28, 28, 0.62);
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .service-card {
    display: grid;
    grid-template-columns: 74px 1fr;
    min-height: 340px;
    padding: 32px;
    border: 1px solid rgba(28, 28, 28, 0.13);
    border-radius: 18px;
    background: rgba(232, 223, 209, 0.32);
    transition:
      background-color 240ms ease,
      transform 240ms ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    background: var(--color-white);
  }

  .service-number {
    color: rgba(28, 28, 28, 0.35);
    font-family: var(--font-serif);
    font-size: 18px;
  }

  .service-card-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .service-card-copy > span {
    margin-bottom: 20px;
    color: rgba(28, 28, 28, 0.48);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .service-card h3 {
    margin-bottom: 14px;
    font-family: var(--font-serif);
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 400;
    line-height: 1;
  }

  .service-card p {
    max-width: 430px;
    color: rgba(28, 28, 28, 0.62);
    line-height: 1.55;
  }

  .service-card a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: auto;
    padding-top: 30px;
    color: var(--color-primary-alt);
    font-size: 13px;
    font-weight: 600;
  }

  .service-card a img {
    transition: transform 180ms ease;
  }

  .service-card a:hover img,
  .service-card a:focus-visible img {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .services-page {
      padding-block: 72px 56px;
    }

    .section-intro,
    .section-intro > div {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 700px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .services-page {
      padding-block: 56px 40px;
    }

    .section-intro {
      margin-bottom: 36px;
    }

    .service-card {
      grid-template-columns: 42px 1fr;
      min-height: 310px;
      padding: 24px 20px;
    }
  }
</style>
