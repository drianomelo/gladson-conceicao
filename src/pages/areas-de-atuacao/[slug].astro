---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import InternalHero from "../../components/InternalHero.astro";
import ContactCta from "../../components/ContactCta.astro";
import ClosingSection from "../../components/ClosingSection.astro";
import iconCheck from "../../assets/icons/check.svg";
import { services, type Service } from "../../data/services";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const title = `${service.title} em Sergipe | Gladson Conceição`;
const description = service.summary;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: title,
      description,
      breadcrumb: { "@id": `${canonicalURL.href}#breadcrumb` },
    },
    {
      "@type": "Service",
      "@id": `${canonicalURL.href}#service`,
      name: service.title,
      description: service.summary,
      url: canonicalURL.href,
      provider: {
        "@id": "https://gladsonconceicao.com.br/#legal-service",
      },
      areaServed: [
        { "@type": "State", name: "Sergipe" },
        { "@type": "Country", name: "Brasil" },
      ],
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL.href}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Início",
          item: "https://gladsonconceicao.com.br/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Áreas de atuação",
          item: "https://gladsonconceicao.com.br/areas-de-atuacao/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: service.title,
          item: canonicalURL.href,
        },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={serviceSchema}>
  <Header />
  <main id="main-content">
    <InternalHero
      eyebrow={service.eyebrow}
      title={service.title}
      description={service.summary}
      current={service.title}
    />

    <section class="service-intro" aria-labelledby="service-intro-title">
      <div class="container service-intro-grid">
        <div data-reveal="up">
          <span>Visão geral</span>
          <h2 id="service-intro-title">
            Orientação que começa pela compreensão do contexto
          </h2>
        </div>
        <div class="service-intro-copy" data-reveal="up">
          <p>{service.intro}</p>
          <p class="legal-note">
            Cada situação possui particularidades. As possibilidades e os
            procedimentos aplicáveis são definidos somente após a análise do
            caso.
          </p>
        </div>
      </div>
    </section>

    <section class="benefits" aria-labelledby="benefits-title">
      <div class="container benefits-grid">
        <div class="benefits-heading" data-reveal="right">
          <span>Como essa atuação pode ajudar</span>
          <h2 id="benefits-title">Clareza para decidir com segurança</h2>
        </div>
        <ul>
          {
            service.benefits.map((benefit) => (
              <li data-reveal="left">
                <span>
                  <img src={iconCheck.src} alt="" width="10" height="7" />
                </span>
                {benefit}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="process" aria-labelledby="process-title">
      <div class="container">
        <div class="process-heading" data-reveal="up">
          <span>Etapas do atendimento</span>
          <h2 id="process-title">Um caminho organizado e transparente</h2>
        </div>
        <ol>
          {
            service.steps.map(([step, text], index) => (
              <li data-reveal="up">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{step}</h3>
                <p>{text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <ContactCta subject={service.whatsapp} />
    <ClosingSection />
  </main>
</BaseLayout>

<style>
  .service-intro {
    padding-block: 96px;
  }

  .service-intro-grid {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 96px;
  }

  .service-intro span,
  .benefits-heading > span,
  .process-heading > span {
    display: block;
    margin-bottom: 20px;
    color: rgba(28, 28, 28, 0.48);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .service-intro h2,
  .benefits h2,
  .process h2 {
    max-width: 690px;
    font-size: clamp(42px, 5vw, 66px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .service-intro-copy > p:first-child {
    color: rgba(28, 28, 28, 0.72);
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.55;
  }

  .legal-note {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(28, 28, 28, 0.14);
    color: rgba(28, 28, 28, 0.48);
    font-size: 12px;
    line-height: 1.55;
  }

  .benefits {
    padding-block: 80px;
    background: var(--color-primary);
    color: var(--color-background);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: 96px;
  }

  .benefits-heading > span {
    color: rgba(246, 241, 232, 0.48);
  }

  .benefits ul {
    list-style: none;
  }

  .benefits li {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 72px;
    border-bottom: 1px solid rgba(246, 241, 232, 0.14);
    color: rgba(246, 241, 232, 0.75);
    font-size: 17px;
  }

  .benefits li > span {
    display: grid;
    place-items: center;
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(246, 241, 232, 0.12);
  }

  .process {
    padding-block: 96px;
  }

  .process-heading {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    align-items: start;
    margin-bottom: 54px;
  }

  .process ol {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
  }

  .process li {
    min-height: 250px;
    padding: 24px;
    border-top: 1px solid rgba(28, 28, 28, 0.2);
    border-right: 1px solid rgba(28, 28, 28, 0.1);
  }

  .process li > span {
    color: rgba(28, 28, 28, 0.35);
    font-family: var(--font-serif);
    font-size: 15px;
  }

  .process h3 {
    margin-top: 52px;
    margin-bottom: 12px;
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 400;
  }

  .process li p {
    color: rgba(28, 28, 28, 0.58);
    font-size: 14px;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .service-intro-grid,
    .benefits-grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .process-heading {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .process ol {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .service-intro,
    .process {
      padding-block: 56px;
    }

    .benefits {
      padding-block: 56px;
    }

    .process ol {
      grid-template-columns: 1fr;
    }

    .process li {
      min-height: auto;
      border-right: 0;
    }

    .process h3 {
      margin-top: 28px;
    }
  }
</style>
