---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Positioning from "../components/Positioning.astro";
import MainServices from "../components/MainServices.astro";
import SecondaryServices from "../components/SecondaryServices.astro";
import About from "../components/About.astro";
import Attendance from "../components/Attendance.astro";
import Faq from "../components/Faq.astro";
import ClosingSection from "../components/ClosingSection.astro";
---

<BaseLayout
  title="Gladson Conceição | Direito Sucessório"
  description="Advocacia com atuação em Direito Sucessório, Inventários e Planejamento Sucessório em Sergipe e todo o Brasil."
>
  <Header />

  <main id="main-content">
    <Hero />
    <Positioning />
    <MainServices />
    <SecondaryServices />
    <About />
    <Attendance />
    <Faq />
    <ClosingSection />
  </main>
</BaseLayout>
